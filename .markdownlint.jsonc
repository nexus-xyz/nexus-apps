// Generated by the shared agent rules sync. Do not edit. Put local overrides in .markdownlint-cli2.jsonc.
// markdownlint rule configuration (see https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md ).
// All rules use their default severity unless listed here. Set a rule to false to turn it off.
{
  // MD013: line length — cap very long lines; do not apply inside fenced code blocks or tables.
  "MD013": {
    "line_length": 999,
    "code_blocks": false,
    "tables": false
  },
  // MD001: heading levels should increment by one — off (large specs/READMEs use intentional skips).
  "MD001": false,
  // MD024: no duplicate heading text — off (repeated section titles across long docs).
  "MD024": false,
  // MD025: only one top-level heading per document — off (some docs use multiple H1s by convention).
  "MD025": false,
  // MD028: blank lines inside blockquotes — off (CMS / blog HTML varies).
  "MD028": false,
  // MD033: no inline HTML — off (intentional HTML in docs and marketing).
  "MD033": false,
  // MD036: no emphasis used as a heading — off (editorial style in essays and posts).
  "MD036": false,
  // MD041: first line must be a level-1 heading — off (e.g. CLAUDE.md points at @AGENTS.md).
  "MD041": false,
  // MD045: images must have alt text — off (large backlog; enable when alts are filled in).
  "MD045": false,
  // MD049: consistent emphasis style (* vs _) — off (mixed author styles).
  "MD049": false,
  // MD059: descriptive link text — off (subjective; many internal “see X” links).
  "MD059": false,
  // MD060: table column style — off (mixed compact/aligned tables across docs and personal workspaces).
  "MD060": false
}
