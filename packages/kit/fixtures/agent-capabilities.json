{
  "regenerate": "AGENT_CAPABILITIES_BLESS=1 cargo test --locked -p nexus-cli --lib agent_capabilities",
  "agents": [
    {
      "access": {
        "agent": "claude",
        "name": "Claude Code",
        "install": "curl -fsSL https://claude.ai/install.sh | bash",
        "route": "subscription",
        "from": "default",
        "routes": [
          {
            "route": "gateway",
            "access": null,
            "available": true,
            "provider": "anthropic"
          },
          {
            "route": "subscription",
            "access": "subscription",
            "available": true,
            "plan": "Claude",
            "vendor": "Anthropic",
            "login": "claude auth login",
            "loginStatus": "claude auth status --text"
          }
        ]
      },
      "executable": "claude",
      "cliLauncher": true,
      "configuredProvider": null,
      "logout": "claude auth logout",
      "resume": "--resume",
      "capabilities": {
        "gateway": "anthropic",
        "usageReporting": "otel",
        "sessionLog": true,
        "promptArgument": true
      }
    },
