<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The hardened runtime's entitlements of Chromium's five helper apps (packaging/package.sh), which all run the one
     helper binary (src/helper.rs). As Electron and Chromium sign theirs: the renderer's V8 and the GPU process's
     SwiftShader need JIT and writable executable memory, and the plugin helper loads code that is not signed by this
     team. The audio service, which Chromium runs in a helper, opens the microphone for a page. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
