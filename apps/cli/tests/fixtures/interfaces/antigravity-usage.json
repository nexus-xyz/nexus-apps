    },
    {
      "name": "missing thinking count: output is not checked",
      "baseline": -1,
      "rows": [
        {
          "idx": 0,
          "fields": { "1.4.1": 312, "1.4.2": 8878, "1.4.3": 123, "1.4.10": 9 }
        }
      ],
      "expect": {
        "usage": "known",
        "records": [{ "idx": 0, "input_tokens": 8878, "output_tokens": 123, "cache_read_tokens": 0, "cache_creation_tokens": 0 }]
